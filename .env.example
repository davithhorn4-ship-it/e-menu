# Copy to .env and fill in. Never commit .env.

# --- App
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- URLs / Origins
# Comma-separated frontend origins allowed for CORS and the cookie CSRF check.
API_URL=
APP_URLS=http://localhost:3000

# --- Proxy
# Proxies trusted for X-Forwarded-For (the client IP used by rate limits).
# false = API reached directly (default). 1 = behind one proxy / load
# balancer. Never trust a proxy that is not there: clients could then fake
# their IP and bypass the login rate limit.
TRUST_PROXY=false

# --- Uploads
# Folder for uploaded files (profile photos), relative to the project or absolute.
# Served read-only at /uploads/. In Docker, mount a volume here so files survive restarts.
UPLOAD_DIR=uploads

# --- Request / Limits
BODY_JSON_LIMIT=64kb
BODY_URLENCODED_LIMIT=16kb

# --- Swagger (UI at /docs, JSON at /docs-json)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Rate Limit
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
THROTTLE_BLOCK_DURATION_SECONDS=60

# --- Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Database (local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/e_menu"

# --- JWT / Auth
# Generate each secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_COOKIE_DAYS=7
# Auth user cache in ms (0 disables)
AUTH_USER_CACHE_TTL_MS=10000

# --- Seed (npm run db:seed): the first admin account
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Swagger dev login (optional; pre-fills the /docs login example, ignored in production)
SWAGGER_LOGIN_EMAIL=
SWAGGER_LOGIN_PASSWORD=
